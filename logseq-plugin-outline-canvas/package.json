{
  "name": "logseq-plugin-outline-canvas",
  "author": "Danzu",
  "version": "1.2.0",
  "description": "Entity Relationship Diagram (ERD) visualization plugin for Logseq DB. Renders blocks as entities with types, properties, and Outgoing relationships.",
  "license": "MIT",
  "homepage": "https://github.com/hdansou/logseq-outline-canvas#readme",
  "bugs": {
    "url": "https://github.com/hdansou/logseq-outline-canvas/issues"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "erd",
    "entity-relationship",
    "diagram",
    "visualization",
    "database",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hdansou/logseq-outline-canvas"
  },
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.js"
  },
  "logseq": {
    "id": "logseq-plugin-outline-canvas",
    "title": "ERD Canvas",
    "icon": "./icon.png",
    "main": "dist/index.html",
    "unsupportedGraphType": "file"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/github",
        {
          "assets": [
            "logseq-plugin-outline-canvas.zip"
          ]
        }
      ]
    ]
  },
  "devDependencies": {
    "@logseq/libs": "^0.3.3",
    "typescript": "^5.0.0",
    "vite": "^8.0.10",
    "vite-plugin-logseq": "^1.1.2",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "dompurify": "^3.4.2",
    "lodash-es": "^4.18.1"
  }
}
